<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Usa a pasta Documents do usuário: C:\Users\<you>\Documents -->
    <property name="LOG_HOME" value="${user.home}/Documents" />

    <!-- Appender para arquivo com rotação por data + tamanho -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/bibliotecaN.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Arquivos rotacionados por dia e índice, compactados -->
            <fileNamePattern>${LOG_HOME}/bibliotecaN.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Console para desenvolvimento -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Níveis específicos para reduzir ruído (ajuste se quiser) -->
    <logger name="org.springframework" level="INFO" />
    <logger name="org.hibernate" level="WARN" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

</configuration>

